{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cpmm",
  "version": "0.1.0",
  "identifier": "dev.stokoe.cpmm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "cpmm", "width": 1280, "height": 800, "minWidth": 800, "minHeight": 500, "resizable": true }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"] }
}
